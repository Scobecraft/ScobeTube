<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS wird empfohlen. Unverschlüsseltes HTTP ist nur erlaubt, damit die App auch im Heimnetz
     (z. B. http://192.168.x.x:8081) funktioniert – die App zeigt dann einen Warnhinweis. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
